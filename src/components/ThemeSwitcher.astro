---
import { ChevronDown, Monitor, Palette } from "@lucide/astro";
import { DEFAULT_LOCALE, getTranslations, type Locale } from "../i18n";
import {
  DARK_THEMES,
  LIGHT_THEMES,
  THEME_SCHEME_MAP,
  THEME_STORAGE_KEY,
} from "../utils/themes";

interface Props {
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(lang);
---

<details class="dropdown dropdown-end" id="theme-dropdown">
  <summary
    class="btn btn-ghost btn-sm gap-2"
    aria-label={t.theme.chooseTheme}
  >
    <Palette class="size-4" aria-hidden="true" />
    <span class="hidden sm:inline">{t.theme.label}</span>
    <ChevronDown class="size-4 opacity-70" aria-hidden="true" />
  </summary>

  <ul
    class="dropdown-content menu bg-base-200 rounded-box z-50 mt-2 w-56 p-2 shadow-lg border border-base-300 max-h-96 overflow-y-auto flex-nowrap"
  >
    <li class="menu-title text-xs uppercase tracking-wider opacity-60">
      {t.theme.groups.system}
    </li>
    <li>
      <button
        type="button"
        data-set-theme="system"
        class="justify-between"
      >
        <span class="flex items-center gap-2">
          <Monitor class="size-4" aria-hidden="true" />
          {t.theme.names.system}
        </span>
      </button>
    </li>

    <li class="menu-title mt-1 text-xs uppercase tracking-wider opacity-60">
      {t.theme.groups.light}
    </li>
    {
      LIGHT_THEMES.map((theme) => (
        <li>
          <button
            type="button"
            data-set-theme={theme.id}
            class="justify-between"
          >
            <span>{t.theme.names[theme.id]}</span>
            <span
              data-theme={theme.id}
              class="bg-base-100 border border-base-content/20 grid grid-cols-2 gap-0.5 rounded-md p-1 shadow-xs"
              aria-hidden="true"
            >
              <span class="bg-base-content size-1.5 rounded-full" />
              <span class="bg-primary size-1.5 rounded-full" />
              <span class="bg-secondary size-1.5 rounded-full" />
              <span class="bg-accent size-1.5 rounded-full" />
            </span>
          </button>
        </li>
      ))
    }

    <li class="menu-title mt-1 text-xs uppercase tracking-wider opacity-60">
      {t.theme.groups.dark}
    </li>
    {
      DARK_THEMES.map((theme) => (
        <li>
          <button
            type="button"
            data-set-theme={theme.id}
            class="justify-between"
          >
            <span>{t.theme.names[theme.id]}</span>
            <span
              data-theme={theme.id}
              class="bg-base-100 border border-base-content/20 grid grid-cols-2 gap-0.5 rounded-md p-1 shadow-xs"
              aria-hidden="true"
            >
              <span class="bg-base-content size-1.5 rounded-full" />
              <span class="bg-primary size-1.5 rounded-full" />
              <span class="bg-secondary size-1.5 rounded-full" />
              <span class="bg-accent size-1.5 rounded-full" />
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</details>

<script define:vars={{ storageKey: THEME_STORAGE_KEY, schemeMap: THEME_SCHEME_MAP }}>
  const dropdown = document.getElementById("theme-dropdown");
  const buttons = document.querySelectorAll("[data-set-theme]");

  function applyTheme(themeId, persist = true) {
    const meta = document.querySelector('meta[name="color-scheme"]');
    const validTheme = themeId && themeId !== "system" && schemeMap[themeId] ? themeId : null;

    if (validTheme) {
      document.documentElement.setAttribute("data-theme", validTheme);
      if (meta) meta.setAttribute("content", schemeMap[validTheme]);
      if (persist) {
        try {
          localStorage.setItem(storageKey, validTheme);
        } catch {}
      }
    } else {
      document.documentElement.removeAttribute("data-theme");
      if (meta) meta.setAttribute("content", "light dark");
      if (persist) {
        try {
          localStorage.removeItem(storageKey);
        } catch {}
      }
    }

    const active = validTheme ?? "system";
    buttons.forEach((btn) => {
      const isSelected = btn.getAttribute("data-set-theme") === active;
      btn.classList.toggle("menu-active", isSelected);
      btn.setAttribute("aria-pressed", String(isSelected));
    });
  }

  let initial = "system";
  try {
    initial = localStorage.getItem(storageKey) || "system";
  } catch {}
  applyTheme(initial, false);

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.getAttribute("data-set-theme") || "system";
      applyTheme(target, true);
      if (dropdown instanceof HTMLDetailsElement) {
        dropdown.open = false;
      }
    });
  });

  document.addEventListener("click", (event) => {
    if (
      dropdown instanceof HTMLDetailsElement &&
      dropdown.open &&
      event.target instanceof Node &&
      !dropdown.contains(event.target)
    ) {
      dropdown.open = false;
    }
  });

  window.addEventListener("storage", (event) => {
    if (event.key === storageKey) {
      applyTheme(event.newValue || "system", false);
    }
  });
</script>
