---
import { ArrowLeft, ArrowRight, Download } from "@lucide/astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import BookCard from "../components/BookCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getTranslations, localizePath, type Locale } from "../i18n";
import Layout from "../layouts/Layout.astro";
import {
  getBookDownloads,
  getBookLanguages,
  getBookSlug,
  type BookEntry,
} from "../utils/books";

interface Props {
  lang: Locale;
  entry: BookEntry;
  related: BookEntry[];
  alternateUrls: Partial<Record<Locale, string>>;
}

const { lang, entry, related, alternateUrls } = Astro.props;
const t = getTranslations(lang);
const { Content } = await render(entry);
const book = entry.data;
const slug = getBookSlug(entry);
const categoryMeta = t.categories[book.category];

const authorsList = book.author
  ? Array.isArray(book.author)
    ? book.author
    : [book.author]
  : [];

const availableLanguages = getBookLanguages(entry);
const downloads = getBookDownloads(entry, lang);

const breadcrumbs = [
  { name: t.nav.home, url: localizePath("/", lang) },
  { name: t.books.title, url: localizePath("/books", lang) },
  {
    name: categoryMeta.name,
    url: localizePath(`/categories/${book.category}`, lang),
  },
  { name: book.title, url: localizePath(`/books/${slug}`, lang) },
];
---

<Layout
  title={t.bookDetail.metaTitle(book.title, book.edition)}
  description={book.description}
  lang={lang}
  book={book}
  breadcrumbs={breadcrumbs}
  alternateUrls={alternateUrls}
>
  <Breadcrumbs items={breadcrumbs} lang={lang} />

  <article data-pagefind-body>
    <div class="items-start gap-8 grid grid-cols-1 md:grid-cols-12">
      <!-- Cover -->
      <div class="md:col-span-5 lg:col-span-4">
        <div class="bg-base-200 shadow-sm card-border overflow-hidden card">
          <figure class="bg-base-200 w-full aspect-3/4">
            {
              book.cover ? (
                <Image
                  src={book.cover}
                  alt={t.books.coverAlt(book.title)}
                  width={480}
                  loading="eager"
                  data-pagefind-meta="image[src], image_alt[alt]"
                  class="w-full h-full object-cover object-top"
                />
              ) : (
                <div class="flex justify-center items-center p-6 w-full h-full text-base-content/50">
                  {t.books.noCover}
                </div>
              )
            }
          </figure>
        </div>
      </div>

      <!-- Details -->
      <div class="space-y-6 md:col-span-7 lg:col-span-8">
        <header>
          <h1
            class="font-bold text-3xl sm:text-4xl tracking-tight"
            data-pagefind-meta="title"
          >
            {book.title}
          </h1>

          <p class="mt-3 text-base text-base-content/80 sm:text-lg leading-relaxed">
            {book.description}
          </p>
        </header>

        <!-- Metadata card -->
        <section class="bg-base-200/50 card-border card">
          <div class="p-5 card-body">
            <h2 class="mb-2 text-base card-title">
              {t.bookDetail.detailsHeading}
            </h2>
            <dl class="gap-x-6 gap-y-3 grid grid-cols-1 sm:grid-cols-2 text-sm">
              <div>
                <dt class="text-base-content/60">
                  {t.bookDetail.fields.category}
                </dt>
                <dd class="mt-0.5 font-medium">
                  <a
                    href={localizePath(`/categories/${book.category}`, lang)}
                    class="link link-hover"
                  >
                    {categoryMeta.name}
                  </a>
                </dd>
              </div>

              <div>
                <dt class="text-base-content/60">
                  {t.bookDetail.fields.edition}
                </dt>
                <dd class="mt-0.5 font-medium">
                  {t.editions[book.edition]}
                </dd>
              </div>

              <div>
                <dt class="text-base-content/60">
                  {t.bookDetail.fields.publisher}
                </dt>
                <dd class="mt-0.5 font-medium">{book.publisher}</dd>
              </div>

              <div>
                <dt class="text-base-content/60">
                  {t.bookDetail.fields.languages}
                </dt>
                <dd class="flex flex-wrap gap-1.5 mt-1">
                  {
                    availableLanguages.map((bookLang) => (
                      <span class="badge badge-soft badge-sm">
                        {t.bookDetail.languageNames[bookLang]}
                      </span>
                    ))
                  }
                </dd>
              </div>

              {
                book.releaseYear && (
                  <div>
                    <dt class="text-base-content/60">
                      {t.bookDetail.fields.releaseYear}
                    </dt>
                    <dd class="mt-0.5 font-medium tabular-nums">
                      {book.releaseYear}
                    </dd>
                  </div>
                )
              }

              {
                authorsList.length > 0 && (
                  <div class="sm:col-span-2">
                    <dt class="text-base-content/60">
                      {authorsList.length > 1
                        ? t.bookDetail.fields.authors
                        : t.bookDetail.fields.author}
                    </dt>
                    <dd class="mt-0.5 font-medium">{authorsList.join(", ")}</dd>
                  </div>
                )
              }

              {
                book.productCode && (
                  <div>
                    <dt class="text-base-content/60">
                      {t.bookDetail.fields.productCode}
                    </dt>
                    <dd class="mt-1 font-mono text-xs">{book.productCode}</dd>
                  </div>
                )
              }

              {
                book.isbn && (
                  <div>
                    <dt class="text-base-content/60">
                      {t.bookDetail.fields.isbn}
                    </dt>
                    <dd class="mt-1 font-mono text-xs">{book.isbn}</dd>
                  </div>
                )
              }

              {
                book.pages && (
                  <div>
                    <dt class="text-base-content/60">
                      {t.bookDetail.fields.pages}
                    </dt>
                    <dd class="mt-0.5 font-medium tabular-nums">{book.pages}</dd>
                  </div>
                )
              }
            </dl>
          </div>
        </section>

        <!-- Downloads & Actions -->
        <div class="flex flex-wrap gap-3" data-pagefind-ignore>
          {
            downloads.map((item, idx) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`btn ${idx === 0 ? "btn-primary" : ""}`}
              >
                <Download class="size-4" aria-hidden="true" />
                {t.bookDetail.downloadButton(
                  t.bookDetail.languageNames[item.lang],
                  item.label,
                )}
              </a>
            ))
          }
          <a
            href={localizePath(`/categories/${book.category}`, lang)}
            class="btn"
          >
            <ArrowLeft class="size-4" aria-hidden="true" />
            {t.bookDetail.backToCategory(categoryMeta.name)}
          </a>
        </div>

        <!-- Markdown content -->
        <div class="divider"></div>
        <section>
          <h2 class="mb-3 font-bold text-xl tracking-tight">
            {t.bookDetail.descriptionHeading}
          </h2>
          <div class="text-base-content/90 book-prose">
            <Content />
          </div>
        </section>
      </div>
    </div>
  </article>

  <!-- Related books -->
  {
    related.length > 0 && (
      <section
        data-pagefind-ignore
        class="mt-14 pt-8 border-base-300 border-t"
      >
        <div class="flex justify-between items-center gap-4 mb-5">
          <h2 class="font-bold text-2xl tracking-tight">
            {t.bookDetail.relatedHeading}
          </h2>
          <a
            href={localizePath(`/categories/${book.category}`, lang)}
            class="btn btn-sm btn-ghost"
          >
            {t.books.allInCategory}
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </div>
        <div class="gap-4 grid grid-cols-2 sm:grid-cols-4">
          {related.map((item) => (
            <BookCard book={item} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</Layout>
