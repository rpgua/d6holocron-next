---
import { ArrowRight } from "@lucide/astro";
import { getCollection } from "astro:content";
import BookCard from "../components/BookCard.astro";
import { getTranslations, localizePath, type Locale } from "../i18n";
import Layout from "../layouts/Layout.astro";
import {
  CATEGORY_ORDER,
  EDITION_ORDER,
  getBooksByLocale,
  getBookStats,
  groupBooksByCategory,
} from "../utils/books";
import { withBase } from "../utils/paths";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const allBooks = getBooksByLocale(await getCollection("books"), lang);
const stats = getBookStats(allBooks);
const grouped = groupBooksByCategory(allBooks);
const featuredBooks = grouped.core.slice(0, 6);
const yearRange =
  stats.minYear && stats.maxYear
    ? stats.minYear === stats.maxYear
      ? String(stats.minYear)
      : `${stats.minYear}–${stats.maxYear}`
    : "—";
---

<Layout title={t.home.title} description={t.site.description} lang={lang}>
  <script
    slot="head"
    type="module"
    src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.4.0/model-viewer.min.js"></script>

  <!-- Hero -->
  <section class="bg-base-200 mb-10 border border-base-300 rounded-box overflow-hidden hero">
    <div class="lg:flex-row-reverse flex-col justify-between gap-8 px-6 sm:px-10 py-10 lg:py-12 w-full hero-content">
      <div class="w-full max-w-xs sm:max-w-sm shrink-0">
        <div class="flex justify-center items-center bg-base-300/60 border border-base-300 rounded-box w-full aspect-square overflow-hidden">
          <model-viewer
            src={withBase("/jedi-holocron-128.glb")}
            alt={t.home.holocronAlt}
            auto-rotate
            class="w-full h-full"></model-viewer>
        </div>
      </div>

      <div class="max-w-xl">
        <span class="mb-3 badge badge-soft">{t.home.heroBadge}</span>
        <h1 class="font-bold text-3xl sm:text-5xl tracking-tight">
          {t.home.heroTitle}
        </h1>
        <p class="py-5 text-base text-base-content/80 sm:text-lg leading-relaxed">
          {t.home.heroSubtitle}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={localizePath("/books", lang)} class="btn btn-primary">
            {t.home.ctaCatalog}
          </a>
          <a href={localizePath("/about", lang)} class="btn">
            {t.home.ctaAbout}
          </a>
          <p class="bg-base py-5 text-accent/80 text-base sm:text-base italic leading-relaxed">
            {t.home.heroThanks}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section aria-label={t.about.coverageStatsTitle} class="mb-12">
    <div class="bg-base-200 shadow-xs border border-base-300 w-full stats stats-vertical sm:stats-horizontal">
      <div class="stat">
        <div class="stat-title">{t.home.stats.books}</div>
        <div class="tabular-nums text-2xl sm:text-3xl stat-value">
          {stats.total}
        </div>
      </div>
      <div class="stat">
        <div class="stat-title">{t.home.stats.categories}</div>
        <div class="tabular-nums text-2xl sm:text-3xl stat-value">
          {CATEGORY_ORDER.length}
        </div>
      </div>
      <div class="stat">
        <div class="stat-title">{t.home.stats.editions}</div>
        <div class="tabular-nums text-2xl sm:text-3xl stat-value">
          {EDITION_ORDER.length}
        </div>
      </div>
      <div class="stat">
        <div class="stat-title">{t.home.stats.years}</div>
        <div class="tabular-nums text-2xl sm:text-3xl stat-value">
          {yearRange}
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="mb-12">
    <div class="mb-6">
      <h2 class="font-bold text-2xl tracking-tight">
        {t.home.categoriesSectionTitle}
      </h2>
      <p class="mt-1 text-base-content/75">{t.home.categoriesSectionDesc}</p>
    </div>

    <div class="gap-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {CATEGORY_ORDER.map((category) => (
        <a
          href={localizePath(`/categories/${category}`, lang)}
          class="group bg-base-200/60 hover:bg-base-200 card-border hover:border-primary/50 transition-all duration-200 card">
          <div class="p-5 card-body">
            <div class="flex justify-between items-center gap-2">
              <h3 class="group-hover:text-primary text-lg transition-colors card-title">
                {t.categories[category].name}
              </h3>
              <span class="tabular-nums badge badge-soft">
                {stats.byCategory[category]}
              </span>
            </div>
            <p class="mt-1 text-sm text-base-content/75">
              {t.categories[category].description}
            </p>
            <div class="justify-end mt-auto pt-3 card-actions">
              <span class="inline-flex items-center gap-1 font-medium text-primary text-sm">
                {t.home.viewCategory}
                <ArrowRight class="size-4" aria-hidden="true" />
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Core Rulebooks -->
  {featuredBooks.length > 0 && (
    <section>
      <div class="flex flex-wrap justify-between items-end gap-4 mb-6">
        <div>
          <h2 class="font-bold text-2xl tracking-tight">
            {t.home.featuredTitle}
          </h2>
          <p class="mt-1 text-base-content/75">{t.home.featuredDesc}</p>
        </div>
        <a href={localizePath("/books", lang)} class="btn btn-sm">
          {t.home.viewAllBooks}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="gap-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
        {featuredBooks.map((book) => (
          <BookCard book={book} lang={lang} />
        ))}
      </div>
    </section>
  )}
</Layout>
